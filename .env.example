# open.dgov.mn — Цахим Засаг.
#
# Жинхэнэ файл нь серверийн /opt/open-dgov-mn/.env бөгөөд нууц утгуудтай тул
# энд хэзээ ч commit хийгдэхгүй (.gitignore). Энэ нь тэр файлын хэлбэр.
#
# Уншигдах compose файл нь цөмийн docker-compose.prod.yml — deploy.sh нь
# CORE_REF дээр түгжигдсэн хувилбараар нь татаж авчирдаг. Энэ репод цөмийн
# нэг ч мөр байхгүй: ECOSYSTEM_GIT_STRATEGY §1, Түвшин 1.

# Цөмийн CI-ийн нийтэлсэн образууд. Хаалттай пакет тул rollout бүр дээр
# read:packages эрхтэй токеноор ghcr.io-д нэвтэрнэ — deploy.sh-г үз.
IMAGE_BACKEND=ghcr.io/gerege-systems/open-gerege-nexus/backend
IMAGE_FRONTEND=ghcr.io/gerege-systems/open-gerege-nexus/frontend
IMAGE_TAG=latest

# ------------------------------------------------------------------ энэ стек
# Хостын дээр өөр стек байхгүй ч нэрээ хэлж байгаа нь: маргааш хажууд нь
# sso.dgov.mn боссон өдөр контейнерүүд аль хэдийн ялгаатай нэртэй байна.
# POSTGRES_VOLUME бол дискэн дээрх заагч — хоосон санг эрүүл мэт асаадаг тул
# энэ мөрийг өөрчлөх нь өгөгдөл нүүлгэх ажил, засвар биш.
STACK=dgov_nexus
POSTGRES_VOLUME=dgov_nexus_platform_postgres_data
CATALOG_CACHE_VOLUME=dgov_nexus_catalog_cache
# Портууд нь compose-ийн анхдагч: 5434 postgres, 6381 redis, 8082 backend,
# 3008 frontend — бүгд зөвхөн loopback дээр. nginx блок эдгээрийг барина.
# Энэ хост дээр хоёр дахь стек босгох өдөр л энд дугаар бичигдэнэ.
POSTGRES_HOST_PORT=
REDIS_HOST_PORT=
BACKEND_HOST_PORT=
FRONTEND_HOST_PORT=

POSTGRES_PASSWORD=
# Production дээр үүнгүйгээр сервер асахаас татгалзана.
SSO_DEFAULT_CLIENT_SECRET=

# --------------------------------------------------------------------- домэйн
PUBLIC_ORIGIN=https://open.dgov.mn
# ALLOWED_ORIGINS нь PUBLIC_ORIGIN + энэ жагсаалт. Хоосон орхивол compose нь
# nexus.gerege.mn-ий төхөөрөмжийн шугамуудыг анхдагчаар тавьдаг — өөр
# байрлуулалтын хостуудыг энэ суулгацын CORS ба CSRF-д зөвшөөрөх нь учиргүй,
# тиймээс өөрийн origin-оороо дүүргэв. Төхөөрөмжийн шугам нэмэгдвэл энд.
DEVICE_LINE_ORIGINS=https://open.dgov.mn

# ---------------------------------------------------------------------- брэнд
# Хүсэлт бүр дээр уншигдана — образ биш, тохиргоо.
BRAND_NAME=Цахим Засаг
BRAND_SHORT_NAME=Цахим Засаг
BRAND_DESCRIPTION=Төрийн үйлчилгээ, албан ажлын нэгдсэн орчин
BRAND_THEME_COLOR=#0050b0
# brand/ дотор байгаа файлууд, nginx-ээр /brand/… доор. Лого ба favicon нэг
# зураг: тусад нь зурсан хоёр байхгүй бол нэгийг нь хоёр газар зааж болно гэж
# цөм өөрөө хэлдэг (frontend/lib/brand.ts). Тэр лавлах нь www-data-д
# уншигдахаар байх ёстой — 0700 бол nginx /brand/ дээр 403 буцаана.
BRAND_LOGO_URL=/brand/gov_icon.png
BRAND_ICON_URL=/brand/gov_icon.png
# Зориуд хоосон. Maskable icon бол хэмжээ өөрчлөх ажил биш: Android дугуй
# эсвэл squircle огтолдог тул булан нь тайрагдана. Хоосон бол maskable
# бичлэг огт нийтлэгдэхгүй, launcher энгийнийг нь өөрөө маскална.
BRAND_MASKABLE_ICON_URL=

# eID-ийн харилцах цонх ч мөн энэ байрлуулалтын нэрийг хэлнэ. Хоосон орхивол
# иргэн утсан дээрээ "Gerege Nexus" гэж уншина.
EID_RP_NAME=Цахим Засаг
EID_DISPLAY_TEXT=Цахим Засаг-т нэвтрэх

# ------------------------------------------------------- нэвтрэлт: SSO клиент
# Энэ суулгац хүнийг өөрөө таних биш, sso.dgov.mn дээр таниулна.
# Провайдер дээр бүртгүүлсэн хоёр хаяг:
#   redirect_uris             https://open.dgov.mn/api/v1/auth/sso/callback
#   post_logout_redirect_uris https://open.dgov.mn/
# ба `open.dgov.mn` нь провайдерийн OAUTH_REDIRECT_HOSTS дотор байх ёстой —
# тэр жагсаалт дэд домэйныг өвлүүлдэггүй.
SSO_CLIENT_ISSUER=https://sso.dgov.mn
# Клиентийн id-г провайдер өөрөө гаргадаг («app_» + нэрний slug + санамсаргүй
# найм), гараар сонгодоггүй — sso-clients модулийн handleCreateApp. Тиймээс
# энэ мөр «open-dgov-mn» гэсэн хүслийн нэр биш, бүртгэлийн бодит утга.
SSO_CLIENT_ID=app_opendgovmn_28426259
# Confidential клиент: хоёр тал нь сервер тул PKCE дээр нэмээд нууцаар
# нотолно. Утга нь бүртгэсэн тэр нэг удаад л уншигдана — сан нь зөвхөн
# digest хадгалдаг тул алдвал rotate-secret л гарц.
SSO_CLIENT_SECRET=
SSO_CLIENT_PROVIDER_NAME=Цахим Засгийн нэгдсэн нэвтрэлт
# Провайдерийн баталгаажуулсан ч энд бүртгэлгүй хүнийг ямар байгууллагад
# үүсгэх. Хоосон бол танихгүй хүнийг татгалзана.
SSO_CLIENT_TENANT=dgov
# false: орох цорын ганц зам нь sso.dgov.mn. Провайдер унасан үед энэ мөрийг
# true болгоод backend-ээ дахин асаах нь буцах зам — эндэх нууц үг, eID-ийн
# нэвтрэлт дахин ажиллана.
SSO_CLIENT_LOCAL_LOGIN=false

# ------------------------------------------------------------------ бусад
DEMO_MODE=false
EID_MOCK_MODE=false
